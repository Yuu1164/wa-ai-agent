# --- Konfigurasi Database TiDB Serverless ---
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=username_tidb_anda.root
TIDB_PASSWORD=password_tidb_anda
TIDB_DATABASE=wa_ai_bot

# --- Konfigurasi Otak AI (Gemini API) ---
GEMINI_API_KEY=AIzaSy_isi_api_key_anda
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Konfigurasi WhatsApp Bot ---
# Format internasional tanpa tanda +, spasi, atau strip (contoh: 6281234567890)
BOT_PHONE_NUMBER=628xxxxxxxxxx
# Nama sesi di tabel baileys_auth_state
SESSION_ID=bot_utama
# Jumlah pesan terakhir yang disimpan & dikirim ke AI sebagai konteks (5-8)
MEMORY_LIMIT=6

# --- Konfigurasi Server HTTP Health Check ---
# Port default untuk server HTTP health check
PORT=7860
